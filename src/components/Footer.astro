---
// Site footer: columns of links on the page background (mono label over plain links).
import { site } from '../site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Contact',
    links: [
      { label: 'Email', href: site.links.email },
      { label: 'LinkedIn', href: site.links.linkedin, external: true },
      { label: 'Telegram', href: site.links.telegram, external: true },
      { label: 'Download CV', href: site.cvUrl, download: true },
    ],
  },
  {
    title: 'Case studies',
    links: [
      { label: 'DISio', href: '/work/disio' },
      { label: 'Artchain', href: '/work/artchain' },
    ],
  },
  {
    title: 'Navigation',
    links: [
      { label: 'Work', href: '/#work' },
      { label: 'About', href: '/#about' },
      { label: 'Contact', href: '/#contact' },
    ],
  },
];
---

<footer class="footer">
  {
    columns.map((col) => (
      <nav class="footer__col" aria-label={col.title}>
        <p class="eyebrow">{col.title}</p>
        <ul>
          {col.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={'external' in link && link.external ? '_blank' : undefined}
                rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                download={'download' in link && link.download ? true : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
  }

  <div class="footer__col">
    <p class="eyebrow">Location</p>
    <ul>
      <li>{site.location}</li>
      <li><time class="footer__clock" data-tz={site.timeZone}>&nbsp;</time></li>
    </ul>
  </div>

  <div class="footer__col">
    <p class="eyebrow">{site.name}</p>
    <ul>
      <li>© {year}</li>
      <li>{site.role}</li>
    </ul>
  </div>
</footer>

<script>
  // Local time in Prague, e.g. "14:05 local time"
  const clock = document.querySelector<HTMLElement>('.footer__clock');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: clock.dataset.tz,
    });
    const tick = () => (clock.textContent = `${format.format(new Date())} local time`);
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .footer {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 40px;
    margin-inline: var(--content-inset);
    padding: 40px 0 56px;
    border-top: 1px solid var(--color-border);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-text);
  }

  .footer a {
    transition: color 150ms ease;
  }
  .footer a:hover {
    color: var(--color-text-muted);
  }

  .footer__clock {
    font-variant-numeric: tabular-nums;
  }
</style>
