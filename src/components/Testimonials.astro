---
// Recommendations received on LinkedIn, copied by hand (there is no public API for them).
// `lead` is the line set large; `body` follows in regular text. Initials stand in for photos.
// A long recommendation is shortened to match the others; `url` links to the full text.
import { site } from '../site';

const testimonials = [
  {
    lead: 'Pavel is one of the most talented UX/UI designers I’ve had the pleasure of working with in the past decade of my nearly 20-year career in Product Management.',
    body: [
      'Pavel not only delivers stylish and modern UIs but also does a fantastic job improving usability by thoroughly reviewing existing interfaces, wireframes, and product specs.',
    ],
    url: `${site.links.linkedin}details/recommendations/`,
    name: 'Pavel Djuric',
    role: 'Product Advisory · Blockchain',
    relation: 'Client · Aug 2024',
  },
  {
    lead: 'Pavel is a skilled and responsible professional with whom collaboration is smooth and effective.',
    body: [
      'He communicates openly, listens carefully, and is always supportive when needed. His thoughtful approach and reliability make him a valuable colleague on any project.',
    ],
    name: 'Stanislav Horváth',
    role: 'Full-Stack Engineer · AI-first development',
    relation: 'Same team · Jan 2026',
  },
  // Drafted for Roman and approved by him (2026-10-02).
  {
    lead: 'Pavel designed the website and the brand for ROVER on Boards, and every decision he made has a clear reason behind it.',
    body: [
      'The quality is consistently high, from the identity down to the smallest details of the site. Pavel is always ready to help, explains his thinking openly and delivers on time — working with him was easy from start to finish.',
    ],
    name: 'Roman Kopyrkin',
    role: 'ROVER on Boards · Snowboard apparel',
    relation: 'Client · Website & branding',
  },
];

// Drafts stay out of the page until the author approves the text (then remove `draft`).
const published = testimonials.filter((t) => !('draft' in t && t.draft));

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');
---

<section class="kind" aria-labelledby="kind-title">
  <div class="kind__head">
    <h2 class="eyebrow" id="kind-title">Kind words</h2>
    <p class="kind__statement">What people I’ve worked with say.</p>
  </div>

  <div class="kind__grid" style={`--count: ${published.length}`}>
    {
      published.map((t) => (
        <figure class="quote">
          <blockquote class="quote__text">
            <p class="quote__lead">{t.lead}</p>
            {t.body.map((paragraph) => (
              <p class="quote__body">{paragraph}</p>
            ))}
            {'url' in t && (
              <a class="quote__more" href={t.url} target="_blank" rel="noopener">
                Read the full recommendation on LinkedIn
              </a>
            )}
          </blockquote>
          <figcaption class="quote__author">
            <span class="quote__avatar" aria-hidden="true">
              {initials(t.name)}
            </span>
            <span class="quote__who">
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
              <span class="eyebrow quote__relation">{t.relation}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .kind {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: var(--section-gap) calc(var(--page-inset) + var(--frame-gutter)) 0;
  }

  .kind__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-inline: var(--content-inset);
    text-align: center;
  }
  .kind__statement {
    font-weight: 500;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  /* All cards in one row (one column per review); each is as tall as its text */
  .kind__grid {
    display: grid;
    grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    align-items: start;
    gap: 8px;
    width: 100%;
    padding-inline: 40px; /* same 56px edges as the What I do sheet */
  }

  .quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    margin: 0;
    padding: 40px;
    border-radius: 48px;
    background: var(--color-surface);
  }
  /* Figma "48, corner smoothing 100%": a squircle whose curve runs ~2× the radius along each
     edge. Browsers without corner-shape keep the plain 48px radius. */
  @supports (corner-shape: squircle) {
    .quote {
      border-radius: 96px;
      corner-shape: squircle;
    }
  }

  .quote__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }
  .quote__lead {
    max-width: 26em;
    font-weight: 500;
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-wrap: pretty;
  }
  .quote__lead::before {
    content: '“';
  }
  .quote__lead::after {
    content: '”';
  }
  .quote__body {
    max-width: var(--measure-card);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .quote__more {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .quote__more:hover {
    text-decoration-thickness: 2px;
  }

  .quote__author {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .quote__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-on-dark);
    font-weight: 500;
    font-size: 14px;
    line-height: 1;
  }
  .quote__who {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .quote__name {
    font-weight: 500;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text);
  }
  .quote__role {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--color-text-secondary);
  }
  .quote__relation {
    margin-top: 8px;
  }

  /* Narrow screens: a swipeable carousel that bleeds to the screen edges; the next card peeks in */
  @media (max-width: 900px) {
    .kind__grid {
      display: flex;
      align-items: flex-start; /* each card hugs its text instead of matching the longest */
      width: auto;
      align-self: stretch;
      margin-inline: calc(-1 * var(--page-inset));
      padding-inline: var(--page-inset);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-inset);
      scrollbar-width: none;
    }
    .kind__grid::-webkit-scrollbar {
      display: none;
    }
    .quote {
      flex: 0 0 min(86%, 420px);
      scroll-snap-align: start;
    }
  }

  @media (max-width: 720px) {
    .kind {
      gap: 32px;
    }
    .quote {
      padding: 32px 24px;
      gap: 32px;
    }
    .quote__lead {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>
