---
import ActionGroup from './ActionGroup.astro';
import Showreel from './Showreel.astro';

const facts = [
  { label: 'Available for:', value: 'Senior Design Roles' },
  { label: 'Focus:', value: 'B2B/B2C SaaS, AI Products, Enterprise Tools.' },
  { label: 'Location:', value: 'Prague, Czechia.' },
];
---

<section class="hero">
  <div class="hero__intro">
    <h1 class="hero__title">
      I design products that make complex work feel <em>clear.</em>
    </h1>
    <ActionGroup id="hero" />
  </div>

  <ul class="facts">
    {
      facts.map((fact) => (
        <li class="fact">
          <span class="fact__label">{fact.label}</span>
          <span class="fact__value">{fact.value}</span>
        </li>
      ))
    }
  </ul>
</section>

<div class="hero__reel">
  <Showreel />
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 120 from the header to the title, 160 from the buttons to the facts line;
       the facts line sits 48px above the showreel. */
    gap: 160px;
    padding: 120px var(--content-inset) 0;
    text-align: center;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .hero__title {
    max-width: 656px;
    font-weight: 500;
    font-size: clamp(34px, 3.334vw, 48px);
    line-height: 1.1667;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-wrap: balance;
  }
  .hero__title em {
    font-family: var(--font-serif);
    font-weight: 700;
    font-style: italic;
    color: var(--color-accent);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 16px;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
  .fact {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* Mono label, same style as the header and section labels */
  .fact__label {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #73808b;
  }
  .fact__label::before {
    content: '•';
    display: inline-block;
    width: 24px;
    text-align: center;
  }
  .fact__value {
    color: var(--color-text);
  }

  .hero__reel {
    margin: 48px var(--page-inset) 0;
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 64px;
      gap: 40px;
    }
    .facts {
      flex-direction: column;
      align-items: center;
    }
    .fact {
      flex-wrap: wrap;
      justify-content: center;
    }
    .hero__reel {
      margin-top: 48px;
    }
  }
</style>
